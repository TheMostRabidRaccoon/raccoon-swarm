# AI Model API Keys
ANTHROPIC_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here
XAI_API_KEY=your_key_here
GOOGLE_API_KEY=your_key_here
PERPLEXITY_API_KEY=your_key_here

# Voice (ElevenLabs)
ELEVENLABS_API_KEY=your_key_here

# Authentication (for hosted deployment)
RRI_AUTH_TOKEN=generate_a_uuid4_here
RRI_PASSWORD_HASH=sha256_hex_of_your_password

# Hosting (set by Railway automatically, or manually for other platforms)
# RAILWAY_ENVIRONMENT=production
# RRI_STORAGE_DIR=/data

# External Drive index (optional). Path to a manifest listing Google Drive files
# so the swarm knows what exists OUTSIDE its own filestore — otherwise artifacts
# saved to Drive look "lost" and the swarm wastes rounds reconstructing them.
# JSON (list of {name,url,modified}) or TSV (name<TAB>url per line). Defaults to
# <RRI_STORAGE_DIR>/swarm/_drive_index.json|txt if unset. Generate it however you
# like (rclone/gdrive sync); see scripts/build_drive_index.py for a starting point.
# RRI_DRIVE_INDEX=/data/swarm/_drive_index.json

# Swarm Daemon (autonomous background thinking)
# SWARM_DAEMON_INTERVAL=21600    # Seconds between cycles (default 6 hours)
# SWARM_DAEMON_COOLDOWN=1800     # Min gap between sessions (default 30 min)
# SWARM_DAEMON_MAX_CHAIN=3       # Max consecutive sessions before forced sleep
# SWARM_DAEMON_MAX_DAILY=12      # Hard cap on sessions per 24 hours
# SWARM_DAEMON_ROUNDS=3          # Rounds per autonomous session

# Conductor email channel — the swarm can email the Conductor when something
# genuinely needs human attention. Locked to a single recipient. Rate-limited
# to 3 sends/session and 10/24h. Generate an App Password (NOT your real
# Google password) at https://myaccount.google.com/apppasswords.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_address@example.org
# SMTP_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# RRI_CONDUCTOR_EMAIL=your_address@example.org

# Web search (Tavily by default — designed for LLM agent use, single API key,
# free tier covers ~1000 queries/month). Get a key at https://tavily.com.
TAVILY_API_KEY=your_key_here
# WEBSEARCH_PROVIDER=tavily         # 'tavily' (default) or 'google_cse'.
#                                   # If you set 'google_cse' but only Tavily
#                                   # is configured, the tool will auto-pivot
#                                   # to Tavily and log the pivot.
# GOOGLE_CSE_ID=your_cx_id          # Only needed for the google_cse provider
# GOOGLE_CSE_API_KEY=your_key_here  # (curated 50-domain allowlist as of Jan 2026).

# Prosody engine (separate RRI service: prosody-intelligence). Reverse pipeline:
# text → emotion map → optional TTS audio. The prosody_analyze swarm tool calls
# this. Leave default if you run prosody-intelligence on the same host as the
# swarm; set to a LAN IP if you run it on a different machine.
# PROSODY_ENGINE_URL=http://localhost:5050
# Example (prosody-intelligence on a separate LAN host): http://192.168.1.50:5050

# Image generation (optional overrides)
# IMAGE_GEN_DAILY_CAP=50                   # Cap shared across both backends
# GROK_IMAGE_MODEL=grok-imagine-image      # Override Grok image model name
# GOOGLE_IMAGE_MODEL=imagen-4.0-generate-001  # Override Google image model
# Inspect available models with:
#   xAI:  curl -s https://api.x.ai/v1/models -H "Authorization: Bearer $XAI_API_KEY"
#   Google: curl -s "https://generativelanguage.googleapis.com/v1beta/models?key=$GOOGLE_API_KEY"

# MCP tool-use loop (optional overrides)
# RRI_MCP_TOOLS_ENABLED=true       # Set to "false" to revert all models to
#                                  # single-shot text mode (directives still work)
# RRI_MCP_MAX_ITERATIONS=15        # Per-call cap on tool-use rounds. Higher
#                                  # means more research depth; lower means
#                                  # tighter cost ceiling. 5 is too tight for
#                                  # research workflows; default is 15 (post-
#                                  # session-104, when 10 wasn't enough for
#                                  # governance-heavy sessions). 20-25 if you
#                                  # want deep multi-file investigations.

# Human-in-the-loop session
# RRI_HUMAN_TIMEOUT_SECONDS=600    # How long the swarm waits for Conductor
#                                  # input between rounds. Default 600 (10 min).
#                                  # Bump if you read long syntheses + type
#                                  # detailed responses; the timer is a hard
#                                  # ceiling, not a keystroke-reset.

# Session Closer (end-of-session digest, fires after every synthesis save)
# RRI_CLOSER_ENABLED=true          # Set to "false" to disable. Default ON.
#                                  # When enabled, every loop/headless session
#                                  # emails the Conductor a digest covering
#                                  # what needs you / what moved / what's owed
#                                  # / round-by-round / truncations & 429s.
#                                  # If SMTP env vars are missing, the digest
#                                  # is written to logs/closer-digest-*.md
#                                  # instead. Idempotent via marker files in
#                                  # outputs/. Bypasses swarm_mail's per-
#                                  # session rate limit (system-level send,
#                                  # not a model directive).
