# AI Model API Keys
ANTHROPIC_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here
XAI_API_KEY=your_key_here
GOOGLE_API_KEY=your_key_here
PERPLEXITY_API_KEY=your_key_here

# Model IDs (optional overrides). Unset = defaults in swarm_model_config.py.
# The active entry point loads ~/.env + project .env through swarm_runtime BEFORE
# importing swarm_model_config, so these import-time overrides are honored.
# Restart after changing and verify /config + a live canary.
# RRI_CLAUDE_MODEL=claude-fable-5
# RRI_GPT_MODEL=gpt-5.6-sol
# RRI_GROK_MODEL=grok-4.5
# RRI_GEMINI_MODEL=gemini-3.1-pro-preview
# RRI_PERPLEXITY_MODEL=sonar-pro
# RRI_GPT_REASONING=high
# RRI_GROK_REASONING=high
# Optional nested-agent Grok route; separate topology from ordinary Grok seat.
# RRI_GROK_MULTI_AGENT_MODEL=grok-4.20-multi-agent
# RRI_GROK_MULTI_AGENT_EFFORT=high
# Per-call output-token ceiling for every seat + synthesis (default 8000).
# RRI_MAX_OUTPUT_TOKENS=8000

# Voice (ElevenLabs)
ELEVENLABS_API_KEY=your_key_here

# Authentication (for hosted deployment)
RRI_AUTH_TOKEN=generate_a_uuid4_here
RRI_PASSWORD_HASH=sha256_hex_of_your_password

# Deployment profile — security posture. See docs/stack/auth.md.
#   local  (default) homelab/single machine; LAN bypass on, codeexec open.
#   lan              trusted network; LAN bypass on, persistent secret expected.
#   public           internet-facing; fail closed unless auth/sandbox posture passes.
RRI_DEPLOYMENT_PROFILE=local
RRI_TRUSTED_CIDRS=
RRI_ALLOW_PUBLIC_TRUSTED_CIDRS=false
RRI_CODEEXEC_SANDBOX=
RRI_ALLOW_UNSAFE_PUBLIC_CODEEXEC=false
# RRI_COMPOST_AFTER_DAYS=7

# Hosting (set by Railway automatically, or manually for other platforms)
# RAILWAY_ENVIRONMENT=production
# RRI_STORAGE_DIR=/data

# ============================================================
# Recall / external memory
# ============================================================
# Automatic relevance activation before Round 1 / Single Swarm.
# RRI_AUTO_RECALL=true
# RRI_AUTO_RECALL_DRIVE=true
# RRI_AUTO_RECALL_MAX_CHARS=14000
# Keep semantic embeddings aligned with the current visible filestore.
# RRI_SEMANTIC_AUTO_REFRESH=true

# Read-only Google Drive observation surface. Configure an rclone Drive remote on
# the host, preferably using Drive read-only scope. The tool surface exposes only
# status/search/read; no upload/delete/move/rename operation.
# RRI_DRIVE_REMOTE=gdrive:
# RRI_DRIVE_TIMEOUT=30
# Historical existence-only Drive manifest remains optional fallback context.
# RRI_DRIVE_INDEX=/data/swarm/_drive_index.json

# Swarm Daemon (autonomous background thinking)
# SWARM_DAEMON_INTERVAL=21600
# SWARM_DAEMON_COOLDOWN=1800
# SWARM_DAEMON_MAX_CHAIN=3
# SWARM_DAEMON_MAX_DAILY=12
# SWARM_DAEMON_ROUNDS=3

# Conductor email channel
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_address@example.org
# SMTP_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# RRI_CONDUCTOR_EMAIL=your_address@example.org

# Change-proposal filer. Structured tool/system-change proposals are persisted for
# review; filing is not implementation or deployment.
# RRI_GITHUB_PROPOSAL_TOKEN=github_pat_...
# RRI_GITHUB_PROPOSAL_REPO=owner/repo
# RRI_GITHUB_PROPOSAL_LABELS=change-proposal,needs-review

# Web search
TAVILY_API_KEY=your_key_here
# WEBSEARCH_PROVIDER=tavily
# GOOGLE_CSE_ID=your_cx_id
# GOOGLE_CSE_API_KEY=your_key_here

# Prosody engine
# PROSODY_ENGINE_URL=http://localhost:5050

# Image generation
# IMAGE_GEN_DAILY_CAP=50
# GROK_IMAGE_MODEL=grok-imagine-image
# GOOGLE_IMAGE_MODEL=imagen-4.0-generate-001

# MCP/native tool loop
# RRI_MCP_TOOLS_ENABLED=true
# RRI_MCP_MAX_ITERATIONS=15

# Human-in-the-loop session
# RRI_HUMAN_TIMEOUT_SECONDS=600

# Session Closer: telemetry remains local every session; notification pressure is
# separately controlled. Default signal = notify only when something merits attention.
# RRI_CLOSER_ENABLED=true
# RRI_CLOSER_NOTIFY_MODE=signal   # signal | all | off

# Gazette layer
# RRI_GAZETTE_ENABLED=true

# ============================================================
# Portfolio Workspace — fenced construction surface
# ============================================================
# The workspace token is scoped to sandbox repo(s) for reversible construction and
# draft PR handoff. Production source observation is a separate read-only source_*
# surface; production integration remains on its reviewed route.
# SWARM_WORKSPACE_GITHUB_TOKEN=
# SWARM_WORKSPACE_REPOS=TheMostRabidRaccoon/swarm-lab
# SWARM_WORKSPACE_BASE_BRANCH=main
