# AI Model API Keys
ANTHROPIC_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here
XAI_API_KEY=your_key_here
GOOGLE_API_KEY=your_key_here
PERPLEXITY_API_KEY=your_key_here

# Voice (ElevenLabs)
ELEVENLABS_API_KEY=your_key_here

# Authentication (for hosted deployment)
RRI_AUTH_TOKEN=generate_a_uuid4_here
RRI_PASSWORD_HASH=sha256_hex_of_your_password

# Hosting (set by Railway automatically, or manually for other platforms)
# RAILWAY_ENVIRONMENT=production
# RRI_STORAGE_DIR=/data

# Swarm Daemon (autonomous background thinking)
# SWARM_DAEMON_INTERVAL=21600    # Seconds between cycles (default 6 hours)
# SWARM_DAEMON_COOLDOWN=1800     # Min gap between sessions (default 30 min)
# SWARM_DAEMON_MAX_CHAIN=3       # Max consecutive sessions before forced sleep
# SWARM_DAEMON_MAX_DAILY=12      # Hard cap on sessions per 24 hours
# SWARM_DAEMON_ROUNDS=3          # Rounds per autonomous session

# Conductor email channel — the swarm can email the Conductor when something
# genuinely needs human attention. Locked to a single recipient. Rate-limited
# to 3 sends/session and 10/24h. Generate an App Password (NOT your real
# Google password) at https://myaccount.google.com/apppasswords.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_address@example.org
# SMTP_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# RRI_CONDUCTOR_EMAIL=your_address@example.org

# Image generation (optional overrides)
# IMAGE_GEN_DAILY_CAP=50                   # Cap shared across both backends
# GROK_IMAGE_MODEL=grok-imagine-image      # Override Grok image model name
# GOOGLE_IMAGE_MODEL=imagen-4.0-generate-001  # Override Google image model
# Inspect available models with:
#   xAI:  curl -s https://api.x.ai/v1/models -H "Authorization: Bearer $XAI_API_KEY"
#   Google: curl -s "https://generativelanguage.googleapis.com/v1beta/models?key=$GOOGLE_API_KEY"

# MCP tool-use loop (optional overrides)
# RRI_MCP_TOOLS_ENABLED=true       # Set to "false" to revert all models to
#                                  # single-shot text mode (directives still work)
# RRI_MCP_MAX_ITERATIONS=10        # Per-call cap on tool-use rounds. Higher
#                                  # means more research depth; lower means
#                                  # tighter cost ceiling. 5 is too tight for
#                                  # research workflows; 15-20 if you want
#                                  # deep multi-file investigations.
