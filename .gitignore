# Environment
.env
.env.local

# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/

# macOS
.DS_Store

# Sensitive / runtime data
ideas.json
swarm_memory.json
swarm_memory.backup.json
vault/
raccoon_memory/

# Work-journal: local journal contents and scratch state — privacy-critical.
# personal.md must never be committed. .gitkeep is whitelisted to preserve
# the directories.
journals/*
!journals/.gitkeep
.claude/state/*
!.claude/state/.gitkeep

# Runtime artifacts
*.log
*.mp3
/tmp/

# Output files (generated at runtime)
*.docx

# Scripted-episode assets: hand-dropped art frames and music beds are large
# binaries, not source of truth. Keep directory layout via .gitkeep.
art_frames/**
!art_frames/.gitkeep
!art_frames/**/.gitkeep
music/**
!music/.gitkeep

# IDE
.idea/
.vscode/
*.swp
*.swo
swarm_memory.backup.*.json

# Persistent swarm filestore — populated per-instance at runtime
swarm/

# GrowBot soul file — the robot's live memory, seeded from memory_seed.json
growbot/harness/memory.json
# GrowBot tick receipts — per-run journal output
growbot/harness/journal.jsonl
.env.bak
.env.save
.env.*
.deploy.lock
