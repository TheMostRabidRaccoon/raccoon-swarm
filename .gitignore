# Environment
.env
.env.local

# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/

# macOS
.DS_Store

# Sensitive / runtime data
ideas.json
swarm_memory.json
swarm_memory.backup.json
vault/
raccoon_memory/

# Work-journal: local journal contents and scratch state — privacy-critical.
# personal.md must never be committed. .gitkeep is whitelisted to preserve
# the directories.
journals/*
!journals/.gitkeep
.claude/state/*
!.claude/state/.gitkeep

# Runtime artifacts
*.log
*.mp3
/tmp/

# Output files (generated at runtime)
*.docx

# IDE
.idea/
.vscode/
*.swp
*.swo
