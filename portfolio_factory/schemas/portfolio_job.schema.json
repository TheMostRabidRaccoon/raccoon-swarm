{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rabidraccoonintelligence.org/schemas/portfolio-job.schema.json",
  "title": "RRI Portfolio Factory Job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_version",
    "job_id",
    "portfolio_slug",
    "phase",
    "repo",
    "base_ref",
    "branch",
    "allowed_paths",
    "models",
    "rounds",
    "acceptance",
    "budgets",
    "human_gates",
    "status",
    "created_at"
  ],
  "properties": {
    "job_version": {
      "const": "1"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "portfolio_slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"
    },
    "phase": {
      "enum": [
        "bootstrap",
        "tooling",
        "foundation",
        "spec",
        "build",
        "visual_review",
        "red_team",
        "integrate",
        "release"
      ]
    },
    "repo": {
      "enum": [
        "TheMostRabidRaccoon/raccoon-swarm",
        "TheMostRabidRaccoon/rri-website",
        "TheMostRabidRaccoon/rri-workspace-lab"
      ]
    },
    "base_ref": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "pattern": "^swarm/[a-z0-9._/-]+$"
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prompt_path": {
      "type": "string"
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "gpt",
          "claude",
          "gemini",
          "grok",
          "perplexity"
        ]
      }
    },
    "rounds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_sessions",
        "max_tool_calls",
        "max_runtime_minutes",
        "max_retries"
      ],
      "properties": {
        "max_sessions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "max_runtime_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "max_usd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "human_gates": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "merge",
          "credential_change",
          "paid_service_enable",
          "external_write",
          "public_enable",
          "real_data"
        ]
      }
    },
    "status": {
      "enum": [
        "queued",
        "processing",
        "review",
        "blocked",
        "done",
        "failed"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "result_manifest": {
      "type": [
        "string",
        "null"
      ]
    },
    "blocker": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
